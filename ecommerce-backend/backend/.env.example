# ScaleUp backend environment example.
# Do not paste production secret values into this file.

# Registration confirmations and new-shop Super Admin alerts.
# In production, EMAIL_USER can be confirmation@scaleup.codes.
EMAIL_USER=
EMAIL_PASS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
SUPER_ADMIN_EMAIL=

# Vendor/Admin operational email sender used by support emails and invitations.
ADMIN_EMAIL_USER=
ADMIN_EMAIL_PASS=

# Public links included in registration notifications.
ADMIN_APP_URL=http://localhost:5173
PLATFORM_ROOT_DOMAIN=localhost:3000


# Existing Cloudinary upload credentials used by support attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Existing worker setting used by support email jobs.
WORKER_POLL_INTERVAL_MS=3000

# Support Center configuration. No new cryptographic secret is required:
# support invitations use random opaque tokens and store only SHA-256 hashes.
SUPPORT_DEFAULT_MAX_ACTIVE_TICKETS=5
SUPPORT_RESOLUTION_AUTO_CLOSE_HOURS=72
SUPPORT_AUTO_ASSIGNMENT_ENABLED=true
SUPPORT_INVITATION_TTL_HOURS=24
SUPPORT_MAX_ATTACHMENT_IMAGES=5
SUPPORT_MAX_ATTACHMENT_IMAGE_MB=8
SUPPORT_MAX_ATTACHMENT_VIDEO_MB=30
SUPPORT_CRITICAL_ALERT_EMAILS=

# Comma-separated subscription usage thresholds. Defaults to 80,90,100.
SUBSCRIPTION_USAGE_WARNING_THRESHOLDS=80,90,100

# Optional shared backend cache. Empty = per-process in-memory cache.
# Set the actual Redis connection URL in the backend environment only.
# Local example (requires a running Redis server): redis://127.0.0.1:6379
# Use the provider-supplied rediss:// URL when TLS is required.
# API and worker instances should use the same Redis service.
REDIS_URL=

# AI is enabled only after the documented quiesced accounting cutover.
# See docs/operations/ai-accounting-cutover.md. Never mix old/new writers.
AI_ACCOUNTING_VERSION=0
AI_TENANT_CONCURRENCY=2
AI_RECEIPT_CAPACITY=128
AI_OPERATION_TIMEOUT_MS=60000
AI_REQUEST_RETENTION_HOURS=24
# Backend only. See docs/operations/openai-ai-provider.md.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=2400
OPENAI_PRODUCT_AI_MAX_OUTPUT_TOKENS=2400
OPENAI_TIMEOUT_MS=45000

# Exact public image hostnames only; ownership is checked separately.
TRUSTED_PRODUCT_IMAGE_HOSTS=
AI_IMAGE_DECODE_CONCURRENCY=4
AI_AGGREGATE_PRIVACY_THRESHOLD=3
