# ScaleUp backend environment example.
# Do not paste production secret values into this file.

# Registration confirmations and new-shop Super Admin alerts.
# In production, EMAIL_USER can be confirmation@scaleup.codes.
EMAIL_USER=
EMAIL_PASS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=465
SUPER_ADMIN_EMAIL=

# Vendor/Admin operational email sender used by support emails and invitations.
ADMIN_EMAIL_USER=
ADMIN_EMAIL_PASS=

# Public links included in registration notifications.
ADMIN_APP_URL=http://localhost:5173
PLATFORM_ROOT_DOMAIN=localhost:3000


# Existing Cloudinary upload credentials used by support attachments.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Existing worker setting used by support email jobs.
WORKER_POLL_INTERVAL_MS=3000

# Support Center configuration. No new cryptographic secret is required:
# support invitations use random opaque tokens and store only SHA-256 hashes.
SUPPORT_DEFAULT_MAX_ACTIVE_TICKETS=5
SUPPORT_RESOLUTION_AUTO_CLOSE_HOURS=72
SUPPORT_AUTO_ASSIGNMENT_ENABLED=true
SUPPORT_INVITATION_TTL_HOURS=24
SUPPORT_MAX_ATTACHMENT_IMAGES=5
SUPPORT_MAX_ATTACHMENT_IMAGE_MB=8
SUPPORT_MAX_ATTACHMENT_VIDEO_MB=30
SUPPORT_CRITICAL_ALERT_EMAILS=

# Comma-separated subscription usage thresholds. Defaults to 80,90,100.
SUBSCRIPTION_USAGE_WARNING_THRESHOLDS=80,90,100
